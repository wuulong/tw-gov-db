.SS 🐍 2. Python API 調用 (Programmatic API)
在其他部會子專案或 AI Agent 腳本中可直接 import 呼叫：
.IP
.EX
\f[B]import\f[R] sqlite3
\f[B]from\f[R] modules.g10_mandate_indexer.g10_cli \f[B]import\f[R] resolve_single_org, get_canonical_oid

conn = sqlite3.connect(\(dqevents\-2026Q3/gov\-db\-in/tw\-gov\-db/data/master_agencies.sqlite\(dq)
cursor = conn.cursor()

\f[I]# 1. JIT 動態組織解析\f[R]
res = resolve_single_org(\(dq第二河川局\(dq, cursor)
print(res[\(dqsuccessor\(dq])     \f[I]# 經濟部水利署第二河川分署\f[R]
print(res[\(dqsuccessor_oid\(dq]) \f[I]# 2.16.886.101.20003.20007.20014.20025\f[R]

\f[I]# 2. 官方權威 OID 查詢\f[R]
oid = get_canonical_oid(\(dq農業部\(dq)
print(oid)                  \f[I]# 2.16.886.101.20003.20064\f[R]
.EE
