.SS 🐍 3. Python API 調用 (Programmatic API)
.IP
.EX
\f[B]from\f[R] modules.g20_spatial_indexer.g20_cli \f[B]import\f[R] parse_address_string

res = parse_address_string(\(dq桃園縣中壢市中正路1號\(dq)
print(res[\(dqnormalized_address\(dq]) \f[I]# 桃園市中壢區中正路1號\f[R]
print(res[\(dqzipcode\(dq])            \f[I]# 320\f[R]
print(res[\(dqais_level\(dq])          \f[I]# HIGH\f[R]
.EE
