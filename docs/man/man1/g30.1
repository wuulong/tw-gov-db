echo \(aq{\(dqevent\(dq: \(dqflood_alert\(dq, \(dqriver_code\(dq: \(dq130000\(dq}\(aq \f[B]|\f[R] python src/modules/g30_hydrology_indexer/g30_cli.py hydrate \-j
